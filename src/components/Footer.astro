---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <Logo />
    <ul>
      <li><a href="https://github.com/dejan0milosevic" rel="me">GitHub</a></li>
    </ul>
    <p class="copy">© {year} dejan0milosevic</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
  }
  ul {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  .copy {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
